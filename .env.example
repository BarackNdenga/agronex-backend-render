# URL HTTPS publique utilisée pour les callbacks OAuth
AGRONEX_PUBLIC_BASE_URL=https://agronexapp-uqaftoxe.manus.space
AGRONEX_ADMIN_EMAILS=admin@example.com,autre-admin@example.com

# Manus OAuth côté navigateur — valeurs publiques injectées au build Vite
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# Authentification sociale — secrets serveur uniquement
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=

# Mobile Money — tous les opérateurs restent désactivés par défaut.
# Ne renseigner ces valeurs qu’au moment de l’intégration contractuelle.
AGRONEX_ORANGE_MONEY_CLIENT_ID=
AGRONEX_ORANGE_MONEY_CLIENT_SECRET=
AGRONEX_ORANGE_MONEY_API_BASE_URL=
AGRONEX_ORANGE_MONEY_ENABLED=false

AGRONEX_AIRTEL_MONEY_CLIENT_ID=
AGRONEX_AIRTEL_MONEY_CLIENT_SECRET=
AGRONEX_AIRTEL_MONEY_API_BASE_URL=
AGRONEX_AIRTEL_MONEY_ENABLED=false

AGRONEX_AFRIMONEY_CLIENT_ID=
AGRONEX_AFRIMONEY_CLIENT_SECRET=
AGRONEX_AFRIMONEY_API_BASE_URL=
AGRONEX_AFRIMONEY_ENABLED=false

AGRONEX_MPESA_MONEY_CLIENT_ID=
AGRONEX_MPESA_MONEY_CLIENT_SECRET=
AGRONEX_MPESA_MONEY_API_BASE_URL=
AGRONEX_MPESA_MONEY_ENABLED=false

# Workers Assets sert frontend et API sur le même domaine : laisser VITE_API_URL vide
VITE_API_URL=
# Ne renseigner que si le frontend et l’API sont ultérieurement séparés
CORS_ORIGINS=
FRONTEND_URL=
