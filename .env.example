# Frontend — valeurs publiques uniquement (la clé publishable n’est jamais une clé secrète)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
VITE_API_URL=https://<project-ref>.supabase.co/functions/v1/agronex-api

# Origine HTTPS du frontend et CORS de l’Edge Function
AGRONEX_PUBLIC_BASE_URL=https://votre-frontend.example
CORS_ORIGINS=https://votre-frontend.example

# Supabase injecte SUPABASE_URL, SUPABASE_DB_URL, SUPABASE_PUBLISHABLE_KEYS et SUPABASE_SECRET_KEYS
# Ne jamais ajouter les valeurs SUPABASE_SECRET_KEYS, service_role ou le mot de passe Postgres à ce fichier.
# L’allowlist admin est stockée sous forme de hash SHA-256 dans public.agronex_admin_allowlist.
# Définir comme secret Edge Function l’adresse e-mail du propriétaire; son rôle admin est attribué côté serveur après vérification.
AGRONEX_OWNER_EMAIL=
# Les sessions membres et administrateurs utilisent exclusivement les jetons Supabase Auth.

# Configuration Mobile Money facultative; les opérateurs restent désactivés par défaut.
AGRONEX_ORANGE_MONEY_ENABLED=false
AGRONEX_AIRTEL_MONEY_ENABLED=false
AGRONEX_AFRIMONEY_ENABLED=false
AGRONEX_MPESA_MONEY_ENABLED=false
